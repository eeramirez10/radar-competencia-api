# PostgreSQL administrado por Docker. Usa una contraseña larga y URL-safe.
POSTGRES_DB=radar_competencia
POSTGRES_USER=radar_app
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_HOST_PORT=5432

# Estas URLs permiten usar Prisma desde el host. Dentro de Docker, Compose las
# sustituye automáticamente para apuntar al servicio `postgres`.
DATABASE_URL="postgresql://radar_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/radar_competencia"
DIRECT_URL="postgresql://radar_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/radar_competencia"

# Conserva las URLs anteriores de Neon sólo como respaldo fuera del despliegue.
# NEON_DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER/neondb?sslmode=require"
# NEON_DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require"

PORT=3010
STORAGE_DIR="./storage"
HOST_PORT=3010
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
AUTH_SESSION_TTL_HOURS=12
# CUSTOMER_API_BASE_URL="https://ejemplo.com"
# CUSTOMER_API_PATH="/api/erp/customers/monthly-sales-summary"
