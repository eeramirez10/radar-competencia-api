# URL con pooling de Neon (hostname con -pooler), usada por el backend.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER/neondb?sslmode=require"

# URL directa de Neon (sin -pooler), usada por Prisma Migrate.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require"

PORT=3010
STORAGE_DIR="./storage"
HOST_PORT=3010
